# Local PostgreSQL settings used by Docker Compose.
POSTGRES_DB=financial_tracker
POSTGRES_USER=financial_tracker
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django development settings.
DJANGO_SECRET_KEY=local-development-key-change-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=
APP_PORT=8000
